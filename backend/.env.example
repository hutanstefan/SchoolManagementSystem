# Settings of the API. Used by `npm run start:dev`, and also by the API container in Docker
# (which overrides DATABASE_URL, NODE_ENV, PORT, JWT_*, CORS_ORIGINS and TRUST_PROXY).
NODE_ENV=development
PORT=3000

# Matches the defaults in the root docker-compose.yml. 127.0.0.1, not "localhost":
# Docker publishes the database on IPv4 only, and some tools (prisma migrate on
# Windows) try IPv6 (::1) first for "localhost".
DATABASE_URL=postgresql://school:school@127.0.0.1:5432/school_db?schema=public

# Secret used to sign JWTs (at least 32 characters). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnopqrstuvwxyz
JWT_EXPIRES_IN_SECONDS=3600

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (1 behind nginx in Docker, 0 locally)
TRUST_PROXY=0

# AI that reads grades from photos of tests: auto | gemini | claude | demo.
# "auto" uses Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set,
# else demo mode with simulated results.
AI_PROVIDER=auto
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried when the main model is rate-limited or busy (each model has its own free quota)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-2.5-flash
# Paid key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Photos read at the same time (keep it low on free tiers), and the longest time
# spent on one photo when the AI is busy, waits included.
AI_CONCURRENCY=2
AI_RETRY_SECONDS=60

# Where uploaded files (lectures) are kept: local | s3
#   local: a folder of the API (works out of the box; in Docker it is mounted from backend/storage)
#   s3:    any S3-compatible bucket, private. Free tiers: Cloudflare R2 (10 GB, needs a card)
#          or Backblaze B2 (10 GB, no card). Create a bucket and a read & write key for it.
# Put the real keys in backend/.env only: this file is committed.
STORAGE_DRIVER=local
STORAGE_DIR=storage
# For STORAGE_DRIVER=s3:
#   R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, S3_REGION=auto
#   B2: S3_ENDPOINT=https://s3.<region>.backblazeb2.com, S3_REGION=<region> (e.g. eu-central-003)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for servers that want the bucket in the path (MinIO); R2, B2 and AWS: false
S3_FORCE_PATH_STYLE=false
# How long a preview or download link works, in seconds
FILE_LINK_SECONDS=300
