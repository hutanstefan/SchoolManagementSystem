NODE_ENV=development
PORT=3000

# Matches the defaults in the root docker-compose.yml
DATABASE_URL=postgresql://school:school@localhost:5432/school_db?schema=public

# Secret used to sign JWTs (at least 32 characters). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnopqrstuvwxyz
JWT_EXPIRES_IN_SECONDS=3600

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (1 behind nginx in Docker, 0 locally)
TRUST_PROXY=0
