// Prisma schema for the School Management System.
// Docs: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Explicit, so the output doesn't depend on whether tsconfig.json is present
  // when the client is generated (e.g. during `npm ci` in the Docker build).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum GradeAction {
  CREATED
  UPDATED
  DELETED
}

/// What a notification is about (picks its icon and wording in the app).
enum NotificationType {
  GRADE_ADDED
  GRADE_CHANGED
  GRADE_REMOVED
  TIMETABLE_CHANGED
  ASSIGNMENT_CHANGED
  HOMEROOM_ALERT
  /// A teacher shared a lecture (PDF) with the student.
  LECTURE_SHARED
  /// A student is close to the absence limit of a subject.
  ABSENCE_WARNING
  /// A student went over the absence limit of a subject.
  ABSENCE_LIMIT
}

enum ConversationType {
  /// Two people.
  DIRECT
  /// Created by a teacher or an admin, with any number of members.
  GROUP
}

enum ChatRole {
  /// The creator of a group: renames it, adds and removes members, deletes it.
  OWNER
  MEMBER
}

enum MessageKind {
  TEXT
  /// Written by the app: "Mihai Ionescu added Ana Pop".
  SYSTEM
}

/// An open school year (one at a time) or a finished one, kept as an archive.
enum SchoolYearStatus {
  ACTIVE
  CLOSED
}

/// What happened to a student at the end of a school year.
enum YearOutcome {
  /// Passed every subject (maybe after a re-exam): moves up a grade.
  PROMOTED
  /// Repeats the grade (repetent).
  REPEATING
  /// Passed the last grade (12th): leaves the school.
  GRADUATED
}

/// Colour of a subject in the app (timetable, gradebook, charts), chosen by the admin.
enum SubjectColor {
  INDIGO
  VIOLET
  PINK
  ROSE
  ORANGE
  AMBER
  LIME
  EMERALD
  TEAL
  SKY
}

/// The icon a subject is drawn with, chosen by the admin (drawn by the web app).
enum SubjectIcon {
  BOOK
  CALCULATOR
  SIGMA
  PI
  RULER
  SHAPES
  PUZZLE
  ATOM
  MAGNET
  FLASK
  DNA
  MICROSCOPE
  LEAF
  HEART
  BRAIN
  TELESCOPE
  LANDMARK
  SCROLL
  GLOBE
  MOUNTAIN
  COMPASS
  LANGUAGES
  FEATHER
  PENCIL
  MESSAGE
  LAPTOP
  CODE
  CPU
  WRENCH
  LIGHTBULB
  PALETTE
  MUSIC
  DRAMA
  CAMERA
  DUMBBELL
  SCALE
  TRENDING
  USERS
  CHURCH
  GRADUATION
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

/// Login identity shared by every role. Role-specific data lives in Student / Teacher.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  /// Incremented on logout and password reset. Tokens carry the version they were
  /// issued with, so every older token is rejected immediately.
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student              Student?
  teacher              Teacher?
  /// Grade changes made by this user.
  gradeChanges         GradeHistory[]
  notifications        Notification[]
  createdConversations Conversation[]
  chatMemberships      ConversationMember[]
  messages             Message[]
  /// Lecture access this user gave or removed.
  lectureAccessEvents  LectureAccessEvent[]
  /// What this user did (the activity log).
  auditLogs            AuditLog[]
  absencesRecorded     Absence[]            @relation("AbsenceRecordedBy")
  absencesExcused      Absence[]            @relation("AbsenceExcusedBy")

  @@map("users")
}

model Student {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  /// Number in the school register (număr matricol): year of enrollment and
  /// number among that year's enrollments, e.g. "2026-0042". Never changes.
  registrationNumber String   @unique @map("registration_number")
  dateOfBirth        DateTime @map("date_of_birth") @db.Date

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The class the student was in, in each school year.
  enrollments   Enrollment[]
  grades        Grade[]
  absences      Absence[]
  gradeHistory  GradeHistory[]
  reexams       Reexam[]
  /// Lectures shared with the student.
  lectureAccess       LectureAccess[]
  lectureAccessEvents LectureAccessEvent[]

  @@map("students")
}

/// The last registration number given in each year. Numbers are never given
/// twice, not even after the student who had one is deleted (like a paper
/// school register).
model RegistrationCounter {
  year       Int @id
  lastNumber Int @map("last_number")

  @@map("registration_counters")
}

model Teacher {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Classes where this teacher is the homeroom teacher (diriginte).
  homeroomClasses Class[]
  /// Subjects this teacher teaches, per class.
  classSubjects   ClassSubject[]
  grades          Grade[]
  lectures        Lecture[]

  @@map("teachers")
}

/// A class in one school year: "9A" in 2026–2027 is a different row from "9A"
/// in 2025–2026. At the end of a year its students move up to the next
/// class ("10A"), which points back to this one. A class has one homeroom
/// teacher (diriginte) and its students (enrollments).
model Class {
  id                String   @id @default(uuid()) @db.Uuid
  schoolYearId      String   @map("school_year_id") @db.Uuid
  /// Unique within the school year, e.g. "9A". The number is the grade level.
  name              String
  homeroomTeacherId String?  @map("homeroom_teacher_id") @db.Uuid
  /// The class these students were in the year before (9A for this 10A).
  previousClassId   String?  @map("previous_class_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  schoolYear      SchoolYear     @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  /// Deleting a teacher leaves the class without a homeroom teacher.
  homeroomTeacher Teacher?       @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  previousClass   Class?         @relation("ClassContinuation", fields: [previousClassId], references: [id], onDelete: SetNull)
  nextClasses     Class[]        @relation("ClassContinuation")
  /// Deleting a class unenrolls its students (they stay in the school).
  enrollments     Enrollment[]
  subjects        ClassSubject[]

  @@unique([schoolYearId, name])
  /// Target of the composite foreign key from enrollments (same school year).
  @@unique([id, schoolYearId])
  @@index([homeroomTeacherId])
  @@map("classes")
}

/// A school year, e.g. 2026–2027, with two semesters. Grades belong to a
/// year and a semester; classes belong to a year.
model SchoolYear {
  id               String           @id @default(uuid()) @db.Uuid
  /// 2026 for 2026–2027.
  startYear        Int              @unique @map("start_year")
  status           SchoolYearStatus @default(ACTIVE)
  /// 1 or 2. New grades go to this semester; teachers can't change the grades
  /// of an earlier one (admins can).
  currentSemester  Int              @default(1) @map("current_semester") @db.SmallInt
  semester1EndedAt DateTime?        @map("semester1_ended_at")
  closedAt         DateTime?        @map("closed_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  classes     Class[]
  enrollments Enrollment[]
  grades      Grade[]
  absences    Absence[]
  reexams     Reexam[]

  @@map("school_years")
}

/// A student in a class for one school year: at most one class per year.
model Enrollment {
  id           String       @id @default(uuid()) @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  classId      String       @map("class_id") @db.Uuid
  /// Copy of the class's year, kept consistent by the composite foreign key,
  /// so the database enforces "one class per student per year".
  schoolYearId String       @map("school_year_id") @db.Uuid
  /// Set when the school year is closed.
  outcome      YearOutcome?
  createdAt    DateTime     @default(now()) @map("created_at")

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId, schoolYearId], references: [id, schoolYearId], onDelete: Cascade)
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, schoolYearId])
  @@index([classId])
  @@map("enrollments")
}

/// A re-exam (examen de corigență) at the end of a year, for a subject whose
/// annual average was under 5. Its grade replaces that average.
model Reexam {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  schoolYearId String   @map("school_year_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  grade        Int      @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at")

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([studentId, schoolYearId, subjectId])
  @@map("reexams")
}

model Subject {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  color         SubjectColor   @default(INDIGO)
  icon          SubjectIcon    @default(BOOK)
  classSubjects ClassSubject[]
  grades        Grade[]
  absences      Absence[]
  reexams       Reexam[]
  lectures      Lecture[]

  gradeHistory GradeHistory[]

  @@map("subjects")
}

/// Teaching assignment: which subjects a class studies, who teaches each one and how many hours per week.
/// A teacher may only grade a student in a subject they teach in that student's class.
model ClassSubject {
  id           String  @id @default(uuid()) @db.Uuid
  classId      String  @map("class_id") @db.Uuid
  subjectId    String  @map("subject_id") @db.Uuid
  /// Null while the position is vacant (or after the teacher was deleted).
  teacherId    String? @map("teacher_id") @db.Uuid
  hoursPerWeek Int     @map("hours_per_week") @db.SmallInt
  /// Most unexcused absences allowed in a semester; null: no limit.
  maxAbsences  Int?    @map("max_absences") @db.SmallInt

  class            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// A subject that is still taught in some class cannot be deleted.
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher          Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  timetableEntries TimetableEntry[]

  @@unique([classId, subjectId])
  /// Target of the composite foreign key from timetable_entries (keeps class_id consistent).
  @@unique([id, classId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("class_subjects")
}

/// One lesson in the weekly timetable: a class-subject in a given day and period (1-8).
model TimetableEntry {
  id             String  @id @default(uuid()) @db.Uuid
  classSubjectId String  @map("class_subject_id") @db.Uuid
  /// Copy of class_subjects.class_id, guaranteed consistent by the composite foreign key.
  /// It exists so the database can enforce "one lesson per class per slot".
  classId        String  @map("class_id") @db.Uuid
  day            Weekday
  period         Int     @db.SmallInt
  room           String?

  classSubject ClassSubject @relation(fields: [classSubjectId, classId], references: [id, classId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([classId, day, period])
  @@index([classSubjectId])
  @@map("timetable_entries")
}

/// A single grade (1-10). The value range is also enforced by a CHECK constraint in the migration.
model Grade {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  /// The teacher who gave the grade. Null if that teacher was deleted (the grade stays in history).
  teacherId    String?  @map("teacher_id") @db.Uuid
  /// The school year and semester (1 or 2) the grade counts for.
  schoolYearId String   @map("school_year_id") @db.Uuid
  semester     Int      @db.SmallInt
  value        Int      @db.SmallInt
  date         DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// A subject that still has grades cannot be deleted.
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher    Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([studentId, subjectId])
  @@index([schoolYearId, semester])
  @@index([teacherId])
  @@map("grades")
}

/// A student missed a lesson: at most one per subject and day. Counted per
/// semester against the subject's limit (class_subjects.max_absences) until
/// it is excused.
model Absence {
  id           String    @id @default(uuid()) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  subjectId    String    @map("subject_id") @db.Uuid
  schoolYearId String    @map("school_year_id") @db.Uuid
  semester     Int       @db.SmallInt
  date         DateTime  @db.Date
  /// Who recorded it; null if that user was deleted.
  recordedById String?   @map("recorded_by_id") @db.Uuid
  excused      Boolean   @default(false)
  excusedAt    DateTime? @map("excused_at")
  excusedById  String?   @map("excused_by_id") @db.Uuid
  /// Why it was excused, e.g. "Medical note".
  excuseNote   String?   @map("excuse_note")
  createdAt    DateTime  @default(now()) @map("created_at")

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// A subject that still has absences cannot be deleted.
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  recordedBy User?      @relation("AbsenceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  excusedBy  User?      @relation("AbsenceExcusedBy", fields: [excusedById], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, date])
  @@index([schoolYearId, semester, subjectId])
  @@index([studentId, schoolYearId, semester])
  @@index([recordedById])
  @@index([excusedById])
  @@map("absences")
}

/// Audit log of every grade change. Rows are never updated or deleted by the app.
model GradeHistory {
  id          String      @id @default(uuid()) @db.Uuid
  /// Plain id, not a foreign key: the history must survive when the grade is deleted.
  gradeId     String      @map("grade_id") @db.Uuid
  studentId   String      @map("student_id") @db.Uuid
  subjectId   String      @map("subject_id") @db.Uuid
  action      GradeAction
  oldValue    Int?        @map("old_value") @db.SmallInt
  newValue    Int?        @map("new_value") @db.SmallInt
  oldDate     DateTime?   @map("old_date") @db.Date
  newDate     DateTime?   @map("new_date") @db.Date
  /// Who made the change. Null if that account was deleted later.
  changedById String?     @map("changed_by_id") @db.Uuid
  changedAt   DateTime    @default(now()) @map("changed_at")

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([gradeId])
  @@index([studentId])
  @@map("grade_history")
}

/// Something that happened that a user should know about: a new grade, a
/// timetable change... Shown in the app and pushed live over WebSocket.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Page of the app to open, e.g. "/student/grades".
  link      String?
  /// Null while unread.
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// A chat: a direct conversation between two people, or a group.
model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  type          ConversationType
  /// Groups only.
  name          String?
  /// Direct conversations only: the two user ids, sorted and joined, so two
  /// people have at most one direct conversation.
  directKey     String?          @unique @map("direct_key")
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  /// For sorting the list: the latest message, or the creation.
  lastMessageAt DateTime         @default(now()) @map("last_message_at")

  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           ChatRole  @default(MEMBER)
  joinedAt       DateTime  @default(now()) @map("joined_at")
  /// Messages after this are unread; null = nothing read yet.
  lastReadAt     DateTime? @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  /// Null if the sender's account was deleted.
  senderId       String?     @map("sender_id") @db.Uuid
  kind           MessageKind @default(TEXT)
  body           String
  createdAt      DateTime    @default(now()) @map("created_at")
  /// Deleted by the sender: the text is gone, the place in the thread stays.
  deletedAt      DateTime?   @map("deleted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

/// Reading material (a PDF) in a teacher's library, not tied to a school
/// year. The teacher shares it with the students they choose (LectureAccess);
/// every change of who can read it is kept (LectureAccessEvent). The file itself is in the storage (a local folder or an S3-compatible
/// bucket such as Cloudflare R2), under `fileKey`; the database only knows
/// where it is.
model Lecture {
  id           String   @id @default(uuid()) @db.Uuid
  /// Null after the teacher was deleted (the lecture stays for its readers).
  teacherId    String?  @map("teacher_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  title        String
  description  String?
  /// Where the file is in the storage, e.g. "lectures/<uuid>.pdf".
  fileKey      String   @unique @map("file_key")
  /// The uploaded file's name, used for downloads.
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  teacher    Teacher?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  access       LectureAccess[]
  accessEvents LectureAccessEvent[]

  @@index([teacherId])
  @@map("lectures")
}

/// A student who can read a lecture now (any student the teacher chooses).
/// Access stays until the teacher removes it.
model LectureAccess {
  lectureId String   @map("lecture_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([lectureId, studentId])
  @@index([studentId])
  @@map("lecture_access")
}

enum LectureAccessAction {
  GRANTED
  REVOKED
}

/// The access history of a lecture: who got or lost access, when and by
/// whom. Rows written by one change share the same `createdAt`.
model LectureAccessEvent {
  id        String              @id @default(uuid()) @db.Uuid
  lectureId String              @map("lecture_id") @db.Uuid
  studentId String              @map("student_id") @db.Uuid
  action    LectureAccessAction
  /// Who changed it; null if that user was deleted.
  actorId   String?             @map("actor_id") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at")

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([lectureId, createdAt])
  @@index([studentId])
  @@index([actorId])
  @@map("lecture_access_events")
}

enum AuditKind {
  /// Something was created, changed or deleted.
  CHANGE
  LOGIN
  LOGOUT
  LOGIN_FAILED
}

/// The activity log: one row per action in the app (a request that changed
/// something, a login or logout), with who did it and what changed. Written
/// by the API, read by admins.
model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  kind        AuditKind
  /// Null for failed logins, or after the user was deleted.
  actorId     String?   @map("actor_id") @db.Uuid
  /// The actor's name and role when it happened, kept if the user is deleted.
  actorName   String?   @map("actor_name")
  actorRole   Role?     @map("actor_role")
  /// The part of the app, e.g. "Grades".
  category    String
  /// What was done, e.g. "Gave a grade".
  action      String
  /// What it was done to, e.g. "9 in Mathematics for Andrei Georgescu".
  target      String?
  method      String?
  path        String?
  /// How many records were created, changed or deleted.
  changeCount Int       @default(0) @map("change_count")
  /// The changes (before and after), the names of the records they refer to.
  details     Json?
  ip          String?
  userAgent   String?   @map("user_agent")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([kind, createdAt])
  @@map("audit_logs")
}
