meta {
  name: Excuse it (as student, 403)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/absences/{{absenceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

body:json {
  {
    "excused": true
  }
}

tests {
  test("Status is 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
