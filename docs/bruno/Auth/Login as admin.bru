meta {
  name: Login as admin
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@school.test",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.getStatus() < 300) bru.setVar("token", res.getBody().accessToken);
}

tests {
  test("Status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Kept last in the folder, so running the whole collection continues as admin.
}
