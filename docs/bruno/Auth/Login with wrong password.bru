meta {
  name: Login with wrong password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@school.test",
    "password": "wrong-password"
  }
}

tests {
  test("Status is 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
