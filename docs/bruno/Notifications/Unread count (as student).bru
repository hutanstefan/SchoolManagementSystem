meta {
  name: Unread count (as student)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/notifications/unread-count
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

tests {
  test("Status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("A number", function () {
    expect(res.getBody().count).to.be.a("number");
  });
}

docs {
  The number on the bell.
}
