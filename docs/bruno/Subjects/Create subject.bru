meta {
  name: Create subject
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/subjects
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Demo subject {{$randomInt}}"
  }
}

script:post-response {
  if (res.getStatus() < 300) bru.setVar("subjectId", res.getBody().id);
}

tests {
  test("Status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
