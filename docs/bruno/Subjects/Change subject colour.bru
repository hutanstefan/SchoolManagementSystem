meta {
  name: Change subject colour
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/subjects/{{subjectId}}
  body: json
  auth: inherit
}

body:json {
  {
    "color": "PINK"
  }
}

tests {
  test("Status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("The colour changed, the name did not", function () {
    expect(res.getBody().color).to.equal("PINK");
    expect(res.getBody().name).to.contain("Renamed subject");
  });
}

docs {
  Each subject has a colour (one of 10), used wherever the subject appears:
  timetables, gradebooks, report cards. A new subject gets the colour fewest
  subjects have, unless one is given.
}
