meta {
  name: Add lesson
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/classes/{{newClassId}}/timetable
  body: json
  auth: inherit
}

body:json {
  {
    "classSubjectId": "{{classSubjectId}}",
    "day": "MONDAY",
    "period": 6,
    "room": "Room 101"
  }
}

script:post-response {
  if (res.getStatus() < 300) bru.setVar("lessonId", res.getBody().id);
}

tests {
  test("Status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
