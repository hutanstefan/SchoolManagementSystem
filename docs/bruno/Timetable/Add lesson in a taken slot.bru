meta {
  name: Add lesson in a taken slot
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/classes/{{newClassId}}/timetable
  body: json
  auth: inherit
}

body:json {
  {
    "classSubjectId": "{{classSubjectId}}",
    "day": "MONDAY",
    "period": 6
  }
}

tests {
  test("Status is 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}

docs {
  Rejected: the class already has a lesson on Monday, period 6.
}
