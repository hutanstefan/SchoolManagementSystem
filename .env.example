# Used by docker-compose.yml. Copy to .env to change them; all values are optional (defaults shown).

# Database
POSTGRES_USER=school
POSTGRES_PASSWORD=school
POSTGRES_DB=school_db
POSTGRES_PORT=5432

# Ports on your machine
WEB_PORT=8080
API_PORT=3000

# Secret used to sign JWTs (at least 32 characters). Set your own outside a local demo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=docker-demo-secret-change-me-0123456789abcdefghij
JWT_EXPIRES_IN_SECONDS=3600
